# Pengaturan Koneksi Database MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=arsip_siswa
DB_PORT=3306

PORT=3000

# Backend API: izinkan origin GitHub Pages dan localhost saat pengembangan.
FRONTEND_ORIGINS=https://anisholikhatin23-ui.github.io,http://localhost:3000,http://127.0.0.1:3000

# Akun admin awal dibuat saat server pertama kali tersambung ke MySQL.
# Gunakan kata sandi kuat dan isi nilainya di environment hosting, jangan commit rahasia ke Git.
INITIAL_ADMIN_USERNAME=staf.tu
INITIAL_ADMIN_NAME=Administrator TU
INITIAL_ADMIN_PASSWORD=

# Google Drive API: bagikan folder Drive sekolah ke email service account sebagai Editor.
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id
# Pilih salah satu cara kredensial:
GOOGLE_SERVICE_ACCOUNT_FILE=C:\path\to\service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
